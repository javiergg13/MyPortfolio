---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import es from "../i18n/es.json";
import en from "../i18n/en.json";

// Netlify sirve esta misma página para cualquier ruta inexistente, sea en
// español o en inglés, así que muestra los dos idiomas.
---

<Layout title={es.NOT_FOUND_SEO_TITLE} description={es.NOT_FOUND_TEXT} noindex>
  <main id="main" class="not-found">
    <p class="code" aria-hidden="true">404</p>
    <div lang="es">
      <h1>{es.NOT_FOUND_TITLE}</h1>
      <p>{es.NOT_FOUND_TEXT}</p>
      <a class="button button-primary" href="/">{es.NOT_FOUND_HOME}</a>
    </div>
    <div lang="en" class="alt">
      <h2>{en.NOT_FOUND_TITLE}</h2>
      <p>{en.NOT_FOUND_TEXT}</p>
      <a class="button button-secondary" href="/en/">{en.NOT_FOUND_HOME}</a>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .not-found {
    width: min(var(--page), 100% - 2 * var(--gutter));
    margin-inline: auto;
    padding-top: clamp(4rem, 14vh, 8rem);
  }
  .code {
    font-size: clamp(5rem, 18vw, 8rem);
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 1;
    color: var(--accent);
  }
  h1 {
    margin-top: 1rem;
    font-size: clamp(2rem, 5vw, 2.75rem);
    letter-spacing: -0.03em;
  }
  h2 {
    font-size: 1.25rem;
  }
  p:not(.code) {
    margin-top: 0.75rem;
    color: var(--muted);
  }
  .button {
    margin-top: 1.5rem;
  }
  .alt {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }
</style>
