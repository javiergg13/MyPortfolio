---
import GitHub from "../icons/GitHub.astro";
import { getI18N, getLocale } from "../i18n/index";

interface Props {
  title: string;
  description: string;
  gitHubUrl?: string;
  technologies?: string[];
  image: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
}

const {
  title,
  description,
  gitHubUrl = "https://github.com/javiergg13",
  technologies = [],
  image,
  imageAlt = title,
  imageWidth = 800,
  imageHeight = 384,
} = Astro.props;

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });
const stack = new Intl.ListFormat(getLocale(currentLocale), {
  type: "conjunction",
}).format(technologies);
---

<article class="project">
  <figure class="shot">
    <img
      src={image}
      alt={imageAlt}
      width={imageWidth}
      height={imageHeight}
      loading="lazy"
      decoding="async"
    />
  </figure>
  <div class="body">
    <h3>{title}</h3>
    <p>{description}</p>
    {stack && <p class="stack">{i18n.PROJECT_STACK} {stack}</p>}
    <a class="button button-secondary" href={gitHubUrl} target="_blank" rel="noopener noreferrer">
      <GitHub /> {i18n.CARD_LINK_TITLE}
    </a>
  </div>
</article>

<style>
  .project {
    display: grid;
    gap: 1.5rem;
  }
  .shot {
    margin: 0;
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
    background: var(--surface);
  }
  .shot img {
    display: block;
    width: 100%;
  }
  h3 {
    font-size: 1.3125rem; /* 21px */
    margin-bottom: 0.5rem;
  }
  .stack {
    margin-top: 0.5rem;
    color: var(--muted);
    font-size: 0.9375rem;
  }
  .button {
    margin-top: 1.25rem;
  }
</style>
