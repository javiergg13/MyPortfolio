---
import SpainFlag from "../flags/Spain.astro";
import EnglandFlag from "../flags/England.astro";
import { getI18N, getLocale, getLocalePath } from "../i18n/index";

const { currentLocale = "es", url } = Astro;
const locale = getLocale(currentLocale);
const i18n = getI18N({ currentLocale });

// Con dos idiomas, un enlace directo al otro es más rápido que un desplegable.
const other =
  locale === "es"
    ? { code: "en", name: "English", Flag: EnglandFlag, href: getLocalePath("en", url.pathname) }
    : { code: "es", name: "Español", Flag: SpainFlag, href: getLocalePath("es", url.pathname) };
---

<a
  href={other.href}
  hreflang={other.code}
  lang={other.code}
  aria-label={i18n.LANG_SWITCH_LABEL}><other.Flag /><span class="name">{other.name}</span></a
>

<style>
  a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    white-space: nowrap;
  }
  a:hover {
    border-color: var(--muted);
  }
  /* En pantallas muy estrechas basta con la bandera; aria-label conserva el nombre. */
  @media (max-width: 460px) {
    .name {
      display: none;
    }
    a {
      padding: 0.45rem 0.55rem;
    }
  }
</style>
