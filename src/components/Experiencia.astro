---
import Job from "../icons/Job.astro";
import { getI18N } from "../i18n/index";

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });
---

<section id="Experiencia" class="section">
  <h2 class="section-title"><Job /> {i18n.EXPERIENCIE_TITLE}</h2>
  <ol class="timeline">
    <li>
      <p class="date">{i18n.EXPERIENCIE_TITLE_1}</p>
      <div class="entry">
        <h3>{i18n.EXPERIENCIE_SUBTITLE_1}</h3>
        <p>
          {i18n.EXPERIENCIE_DESCRIPTION_1_1}<strong
            >{i18n.EXPERIENCIE_DESCRIPTION_1_2}</strong
          >{i18n.EXPERIENCIE_DESCRIPTION_1_3}<strong
            >{i18n.EXPERIENCIE_DESCRIPTION_1_4}</strong
          >{i18n.EXPERIENCIE_DESCRIPTION_1_5}<strong
            >{i18n.EXPERIENCIE_DESCRIPTION_1_6}</strong
          >{i18n.EXPERIENCIE_DESCRIPTION_1_7}<strong
            >{i18n.EXPERIENCIE_DESCRIPTION_1_8}</strong
          >{i18n.EXPERIENCIE_DESCRIPTION_1_9}
        </p>
        <p>
          {i18n.EXPERIENCIE_DESCRIPTION_1_10}{i18n.EXPERIENCIE_DESCRIPTION_1_11}{
            i18n.EXPERIENCIE_DESCRIPTION_1_12
          }{i18n.EXPERIENCIE_DESCRIPTION_1_13}
        </p>
        <p>
          {i18n.EXPERIENCIE_DESCRIPTION_1_14}{i18n.EXPERIENCIE_DESCRIPTION_1_15}{
            i18n.EXPERIENCIE_DESCRIPTION_1_16
          }{i18n.EXPERIENCIE_DESCRIPTION_1_17}{
            i18n.EXPERIENCIE_DESCRIPTION_1_18
          }
        </p>
      </div>
    </li>
    <li>
      <p class="date">{i18n.EXPERIENCIE_TITLE_2}</p>
      <div class="entry">
        <h3>{i18n.EXPERIENCIE_SUBTITLE_2}</h3>
        <p>
          {i18n.EXPERIENCIE_DESCRIPTION_2_1}<strong
            >{i18n.EXPERIENCIE_DESCRIPTION_2_2}</strong
          >{i18n.EXPERIENCIE_DESCRIPTION_2_3}{i18n.EXPERIENCIE_DESCRIPTION_2_4}{
            i18n.EXPERIENCIE_DESCRIPTION_2_5
          }{i18n.EXPERIENCIE_DESCRIPTION_2_6}{i18n.EXPERIENCIE_DESCRIPTION_2_7}{
            i18n.EXPERIENCIE_DESCRIPTION_2_8
          }{i18n.EXPERIENCIE_DESCRIPTION_2_9}
        </p>
      </div>
    </li>
  </ol>
</section>

<style>
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    display: grid;
    grid-template-columns: 11rem 1fr;
    column-gap: 2rem;
  }
  .date {
    padding-top: 0.15rem;
    font-size: 0.9375rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  /* La línea vertical une los puestos: la experiencia sí es una secuencia. */
  .entry {
    position: relative;
    padding-left: 1.75rem;
    padding-bottom: 2.75rem;
    border-left: 1px solid var(--line);
  }
  li:last-child .entry {
    padding-bottom: 0;
  }
  .entry::before {
    content: "";
    position: absolute;
    left: -5px;
    top: 0.5rem;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--muted);
    box-sizing: border-box;
  }
  li:first-child .entry::before {
    background: var(--accent);
    border-color: var(--accent);
  }
  h3 {
    font-size: 1.1875rem;
    margin-bottom: 0.6rem;
  }
  .entry p + p {
    margin-top: 0.6rem;
  }
  strong {
    font-weight: 600;
  }
  @media (max-width: 640px) {
    li {
      grid-template-columns: 1fr;
    }
    .date {
      padding: 0 0 0.35rem 1.75rem;
      border-left: 1px solid var(--line);
    }
    .entry::before {
      top: 0.45rem;
    }
  }
</style>
