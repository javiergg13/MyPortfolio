---
import Job from "../icons/Job.astro";
import { getI18N } from "../i18n/index";

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });
---

<section id="Experiencia" class="section">
  <h2 class="section-title"><Job /> {i18n.EXPERIENCE_TITLE}</h2>
  <ol class="timeline">
    {
      i18n.EXPERIENCE.map((job) => (
        <li>
          <p class="date">{job.date}</p>
          <div class="entry">
            <h3>{job.role}</h3>
            <p class="company">{job.company}</p>
            {job.paragraphs.map((text) => <p set:html={text} />)}
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    display: grid;
    grid-template-columns: 11rem 1fr;
    column-gap: 2rem;
  }
  .date {
    padding-top: 0.15rem;
    font-size: 0.9375rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  /* La línea vertical une los puestos: la experiencia sí es una secuencia. */
  .entry {
    position: relative;
    padding-left: 1.75rem;
    padding-bottom: 2.75rem;
    border-left: 1px solid var(--line);
  }
  li:last-child .entry {
    padding-bottom: 0;
  }
  .entry::before {
    content: "";
    position: absolute;
    left: -5px;
    top: 0.5rem;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--muted);
    box-sizing: border-box;
  }
  li:first-child .entry::before {
    background: var(--accent);
    border-color: var(--accent);
  }
  h3 {
    font-size: 1.1875rem;
  }
  .company {
    margin-top: 0.15rem;
    margin-bottom: 0.75rem;
    font-weight: 600;
    color: var(--accent);
  }
  .entry .company + p {
    margin-top: 0;
  }
  .entry p + p {
    margin-top: 0.6rem;
  }
  .entry :global(strong) {
    font-weight: 600;
  }
  @media (max-width: 640px) {
    li {
      grid-template-columns: 1fr;
    }
    .date {
      padding: 0 0 0.35rem 1.75rem;
      border-left: 1px solid var(--line);
    }
    .entry::before {
      top: 0.45rem;
    }
  }
</style>
