---
import { getI18N } from "../i18n/index";
import LenguagesSelector from "./LenguagesSelector.astro";
import ThemeToggle from "./ThemeToggle.astro";

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });
---

<header>
  <div class="bar">
    <a class="home" href="#SobreMi" aria-label={i18n.HEADER_HOME}>
      <img
        src="/imgs/yo-header-cv.webp"
        alt=""
        width="36"
        height="36"
        loading="eager"
        decoding="async"
      />
      <span>Javier Guerrero</span>
    </a>
    <nav aria-label={i18n.HEADER_NAV}>
      <a href="#Experiencia">{i18n.HEADER_TITLE_2}</a>
      <a href="#Proyectos">{i18n.HEADER_TITLE_3}</a>
      <a href="#Contacto">{i18n.HEADER_TITLE_4}</a>
    </nav>
    <div class="tools">
      <ThemeToggle />
      <LenguagesSelector />
    </div>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid transparent;

    /* Longhands: Lightning CSS no debe fusionar animation-timeline en el
       shorthand de animation, porque Chrome no lo interpreta. */
    animation-name: reveal-line;
    animation-duration: auto;
    animation-timing-function: linear;
    animation-fill-mode: both;
    animation-timeline: scroll(root);
    animation-range: 0 120px;
  }
  .bar {
    width: min(var(--page), 100% - 2 * var(--gutter));
    margin-inline: auto;
    height: var(--header-h);
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  a {
    color: var(--ink);
    text-decoration: none;
  }
  .home {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-right: auto;
  }
  /* El avatar y el nombre aparecen al dejar atrás la portada. */
  .home img,
  .home span {
    animation-name: appear;
    animation-duration: auto;
    animation-timing-function: linear;
    animation-fill-mode: both;
    animation-timeline: scroll(root);
    animation-range: 200px 360px;
  }
  .home img {
    width: 36px;
    height: 36px;
    border-radius: 50%;
  }
  nav {
    --nav-fs: 0.9375rem;
    --nav-fs-to: 1.0625rem;
    display: flex;
    gap: 1.25rem;
    font-size: var(--nav-fs);
  }
  /* Los enlaces crecen a la vez que aparece el avatar. Al estar el nav pegado
     a las herramientas, gana ancho hacia la izquierda; la altura del header
     es fija, así que no cambia. Sin soporte de scroll timelines, se queda
     en el tamaño normal. */
  @supports (animation-timeline: scroll()) {
    nav {
      animation-name: grow-nav;
      animation-duration: auto;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: scroll(root);
      animation-range: 200px 360px;
    }
  }
  .tools {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  nav a {
    color: var(--muted);
    padding-block: 0.25rem;
  }
  nav a:hover {
    color: var(--ink);
  }
  @keyframes reveal-line {
    to {
      border-bottom-color: var(--line);
    }
  }
  @keyframes grow-nav {
    from {
      font-size: var(--nav-fs);
    }
    to {
      font-size: var(--nav-fs-to);
    }
  }
  @keyframes appear {
    from {
      opacity: 0;
      translate: 0 4px;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }
  @media (max-width: 600px) {
    .bar {
      gap: 0.9rem;
    }
    .home span {
      display: none;
    }
    nav {
      --nav-fs: 0.875rem;
      --nav-fs-to: 0.9375rem;
      gap: 0.9rem;
    }
  }
  @media (max-width: 460px) {
    .home {
      display: none;
    }
    /* Sin avatar a la izquierda el nav está pegado al borde: no hay hueco
       hacia el que crecer, así que mantiene su tamaño. */
    nav {
      --nav-fs: 0.8125rem;
      --nav-fs-to: 0.8125rem;
      gap: 0.65rem;
    }
    .tools {
      gap: 0.35rem;
    }
    .bar {
      justify-content: space-between;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .home img,
    .home span,
    nav {
      animation: none;
    }
  }
</style>
