---
import Code from "../icons/Code.astro";
import Card from "./Card.astro";

import { getI18N } from "../i18n/index";

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });

const PROJECTS = [
  {
    title: i18n.MY_PROJECTS_TITLE_1,
    description: i18n.MY_PROJECTS_DESCRIPTION_1,
    tecnologies: ["Astro", "React", "Svelte", "Tailwind"],
    image: "/imgs/spotify-clone-card.webp",
    imageAlt: i18n.MY_PROJECTS_IMAGE_ALT_1,
    imageWidth: 800,
    imageHeight: 384,
    gitHubUrl: "https://github.com/javiergg13/spotify-clone",
  },
];
---

<section id="Proyectos" class="section">
  <h2 class="section-title"><Code /> {i18n.PROJECTS_TITLE}</h2>
  <div class="list">
    {PROJECTS.map((project) => <Card {...project} />)}
  </div>
</section>

<style>
  .list {
    display: grid;
    gap: 3.5rem;
  }
</style>
