---
import Mail from "../icons/Mail.astro";
import MailForward from "../icons/MailForward.astro";
import Phone from "../icons/Phone.astro";
import { getI18N } from "../i18n/index";

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });
---

<section id="Contacto" class="section">
  <h2 class="section-title"><Mail /> {i18n.CONTACT_TITLE}</h2>
  <dl>
    <div>
      <dt>{i18n.CONTACT_EMAIL}</dt>
      <dd>
        <a href="mailto:guerrerogallojavier@gmail.com"
          >guerrerogallojavier@gmail.com</a
        >
      </dd>
    </div>
    <div>
      <dt>{i18n.CONTACT_PHONE}</dt>
      <dd><a href="tel:+34674774983">+34 674 774 983</a></dd>
    </div>
    <div>
      <dt>{i18n.CONTACT_LOCATION}</dt>
      <dd>Pola de Laviana, Asturias</dd>
    </div>
    <div>
      <dt>{i18n.CONTACT_BIRTH}</dt>
      <dd>{i18n.CONTACT_BIRTH_VALUE}</dd>
    </div>
  </dl>
  <div class="actions">
    <a class="button button-primary" href="mailto:guerrerogallojavier@gmail.com"
      ><MailForward /> {i18n.CONTACT_ACTIONS_TITLE_1}</a
    >
    <a class="button button-secondary" href="tel:+34674774983"
      ><Phone /> {i18n.CONTACT_ACTIONS_TITLE_2}</a
    >
  </div>
</section>

<style>
  dl {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 2rem;
  }
  dt {
    font-size: 0.875rem;
    color: var(--muted);
  }
  dd {
    margin: 0.15rem 0 0;
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  .actions {
    margin-top: 2.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  @media (max-width: 520px) {
    dl {
      grid-template-columns: 1fr;
    }
  }
</style>
