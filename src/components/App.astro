---
import Layout from "../layouts/Layout.astro";
import SobreMi from "../components/SobreMi.astro";
import Experiencia from "../components/Experiencia.astro";
import Proyectos from "../components/Proyectos.astro";
import Competencias from "../components/Competencias.astro";
import Contacto from "../components/Contacto.astro";
import Footer from "../components/Footer.astro";

import { getI18N } from "../i18n/index";

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });
---

<Layout title={i18n.SEO_TITLE} description={i18n.SEO_DESCRIPTION}>
  <main id="main">
    <SobreMi />
    <Experiencia />
    <Proyectos />
    <Competencias />
    <Contacto />
  </main>
  <Footer />
</Layout>
