---
import Drive from "../icons/Drive.astro";
import GitHub from "../icons/GitHub.astro";
import LinkedIn from "../icons/LinkedIn.astro";
import { getI18N, getLocale } from "../i18n/index";

const { currentLocale } = Astro;
const i18n = getI18N({ currentLocale });
const locale = getLocale(currentLocale);
---

<section id="SobreMi" class="hero">
  <img
    class="portrait"
    src="/imgs/javier-guerrero-cv.webp"
    alt={i18n.ABOUT_ME_IMAGE_DESCRIPTION}
    width="500"
    height="500"
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />
  <div class="intro">
    <h1>{i18n.ABOUT_ME_TITLE_2}</h1>
    <p class="lead" set:html={i18n.ABOUT_ME_DESCRIPTION} />
    <div class="links">
      <a
        class="button button-primary"
        target="_blank"
        rel="noopener noreferrer"
        href="https://drive.google.com/file/d/1-dL63MY1Hp_ZtjR8aTFoV46pqRCNB3lw/view?usp=sharing"
        ><Drive /> {i18n.ABOUT_ME_CV}</a
      >
      <a
        class="button button-secondary"
        target="_blank"
        rel="noopener noreferrer"
        href="https://www.linkedin.com/in/javier-guerrero-gallo-3989b9228/"
        ><LinkedIn /> LinkedIn</a
      >
      <a
        class="button button-secondary"
        target="_blank"
        rel="noopener noreferrer"
        href="https://github.com/javiergg13"><GitHub /> GitHub</a
      >
    </div>
  </div>

  <!-- Rendimiento real de esta visita, medido con la Performance API. -->
  <p
    class="perf"
    hidden
    data-locale={locale}
    data-text={i18n.PERF_TEXT}
    data-text-cached={i18n.PERF_TEXT_CACHED}
  >
  </p>
</section>

<style>
  .hero {
    width: min(var(--page), 100% - 2 * var(--gutter));
    margin-inline: auto;
    padding-top: 5rem;
    display: grid;
    grid-template-columns: 168px 1fr;
    column-gap: 2.5rem;
    row-gap: 2.5rem;
    align-items: start;
  }
  .portrait {
    width: 168px;
    height: 168px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--line);
  }
  h1 {
    font-size: clamp(2.75rem, 7vw, 4rem); /* 44–64px */
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 0.95;
  }
  .lead {
    margin-top: 1.25rem;
    font-size: 1.1875rem; /* 19px */
    line-height: 1.55;
    color: var(--muted);
  }
  .lead :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }
  .links {
    margin-top: 1.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* El elemento distintivo: el comprobante de esta visita. */
  .perf {
    grid-column: 1 / -1;
    max-width: none;
    padding: 0.9rem 1.1rem;
    border-left: 3px solid var(--accent);
    background: var(--surface);
    border-radius: 0 6px 6px 0;
    font-size: 0.9375rem;
    color: var(--muted);
  }
  .perf :global(b) {
    color: var(--ink);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 640px) {
    .hero {
      padding-top: 2.5rem;
      grid-template-columns: 1fr;
      row-gap: 1.75rem;
    }
    .portrait {
      width: 112px;
      height: 112px;
    }
    .lead {
      font-size: 1.0625rem;
    }
  }
</style>

<script>
  const formatTime = (ms: number, locale: string) =>
    ms < 1000
      ? `${Math.round(ms)} ms`
      : `${new Intl.NumberFormat(locale, { maximumFractionDigits: 2 }).format(ms / 1000)} s`;

  const formatSize = (bytes: number, locale: string) =>
    `${new Intl.NumberFormat(locale, { maximumFractionDigits: 0 }).format(bytes / 1024)} KB`;

  const render = (el: HTMLElement, template: string, time: string, size = "") => {
    el.innerHTML = template
      .replace("{time}", `<b>${time}</b>`)
      .replace("{size}", `<b>${size}</b>`);
  };

  // Bytes transferidos por los recursos que empezaron a descargarse desde `from`.
  const bytesSince = (from: number) =>
    (performance.getEntriesByType("resource") as PerformanceResourceTiming[])
      .filter((r) => r.startTime >= from)
      .reduce((sum, r) => sum + (r.transferSize ?? 0), 0);

  let frame = 0;

  const show = (loadMs: number, bytes: number) => {
    const el = document.querySelector<HTMLElement>(".perf");
    if (!el) return;
    cancelAnimationFrame(frame);

    const locale = el.dataset.locale ?? "es";
    // Por debajo de 1 KB solo viajan cabeceras: el contenido salió de la caché.
    const cached = bytes < 1024;
    const template = (cached ? el.dataset.textCached : el.dataset.text) ?? "";

    el.hidden = false;

    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;
    if (reduceMotion) {
      render(el, template, formatTime(loadMs, locale), formatSize(bytes, locale));
      return;
    }

    // Una única animación en la página: las cifras cuentan hasta su valor.
    const duration = 700;
    const start = performance.now();
    const tick = (now: number) => {
      const t = Math.min((now - start) / duration, 1);
      const eased = 1 - Math.pow(1 - t, 3);
      render(
        el,
        template,
        formatTime(loadMs * eased, locale),
        formatSize(bytes * eased, locale)
      );
      if (t < 1) frame = requestAnimationFrame(tick);
    };
    frame = requestAnimationFrame(tick);
  };

  // Carga completa: el documento más los recursos de esta carga.
  // loadEventEnd solo existe cuando el evento load ha terminado.
  const measureFullLoad = () => {
    const [nav] = performance.getEntriesByType(
      "navigation"
    ) as PerformanceNavigationTiming[];
    if (!nav || nav.loadEventEnd <= 0) return;
    show(nav.loadEventEnd, (nav.transferSize ?? 0) + bytesSince(0));
  };

  if (document.readyState === "complete") setTimeout(measureFullLoad, 0);
  else
    window.addEventListener("load", () => setTimeout(measureFullLoad, 0), {
      once: true,
    });

  // Navegaciones de ClientRouter (p. ej. cambiar de idioma): la página no se
  // recarga, así que solo se mide lo descargado desde que empezó la navegación.
  let softStart: number | null = null;
  document.addEventListener("astro:before-preparation", () => {
    softStart = performance.now();
  });
  document.addEventListener("astro:page-load", () => {
    if (softStart === null) return;
    const from = softStart;
    softStart = null;
    show(performance.now() - from, bytesSince(from));
  });
</script>
