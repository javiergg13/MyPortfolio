# Cabeceras HTTP de Netlify: https://docs.netlify.com/routing/headers/

# Seguridad básica para todas las respuestas.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# CSS, JS y fuentes generados por Astro: llevan un hash en el nombre y cambian
# de nombre en cada build, así que se pueden guardar en caché para siempre.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
